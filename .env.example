# Copy this file to .env and fill in your key to make interviews truly live.
# .env is gitignored. `npm run dev` and `npm start` load it automatically.

# ---- Accounts, friend codes, and the lobby (SOW §6). ALL OPTIONAL.
# Set DATABASE_URL to turn sign-in + lobbies on. Without it the game runs in
# anonymous quick-play, exactly as before — nothing breaks if these are unset.
#   local dev:  a local Postgres, then `npm run db:push` to create the tables
#   production: a Render/Neon/Supabase Postgres connection string
# DATABASE_URL=postgres://user@localhost:5432/cotm_dev
# BETTER_AUTH_SECRET=   # a long random string; REQUIRED in production. `openssl rand -hex 32`
# BETTER_AUTH_URL=http://localhost:2567   # the app's public origin (https://cotm.onrender.com in prod)

# Live interview replies use the local `claude` CLI automatically if you're
# logged into Claude Code (no key needed). Set this only if you don't have the
# CLI — e.g. a deployed server — or to prefer the API.
ANTHROPIC_API_KEY=sk-ant-...

# Force a provider: api | cli | off
# COTM_AI_PROVIDER=cli
# COTM_CLI_MODEL=haiku

# Optional overrides:
# COTM_MODEL=claude-haiku-4-5-20251001
# COTM_LLM_TIMEOUT_MS=15000
# COTM_REVEAL_MS=20000   # fixed wait from question to answer (hides AI vs human timing)
