# Copy this file to .env and fill in your key to make interviews truly live.
# .env is gitignored. `npm run dev` and `npm start` load it automatically.

# Live interview replies use the local `claude` CLI automatically if you're
# logged into Claude Code (no key needed). Set this only if you don't have the
# CLI — e.g. a deployed server — or to prefer the API.
ANTHROPIC_API_KEY=sk-ant-...

# Force a provider: api | cli | off
# COTM_AI_PROVIDER=cli
# COTM_CLI_MODEL=haiku

# Optional overrides:
# COTM_MODEL=claude-haiku-4-5-20251001
# COTM_LLM_TIMEOUT_MS=15000
# COTM_REPLY_MIN_MS=2500
# COTM_REPLY_MAX_MS=14000
# COTM_REPLY_PER_CHAR_MS=55
# COTM_ASK_COOLDOWN_MS=20000   # wait between interview questions
