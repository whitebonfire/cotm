# Copy this file to .env and fill in your key to make interviews truly live.
# .env is gitignored. `npm run dev` and `npm start` load it automatically.

# Required for live AI interview replies. Without it, NPCs fall back to canned
# in-character deflections (not a real conversation).
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides:
# COTM_MODEL=claude-haiku-4-5-20251001
# COTM_LLM_TIMEOUT_MS=15000
# COTM_REPLY_MIN_MS=2500
# COTM_REPLY_MAX_MS=14000
# COTM_REPLY_PER_CHAR_MS=55
